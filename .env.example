# Copy to .env and edit. Everything here can also be changed later in Admin → Runtime.

# Where app data (SQLite + uploaded files) lives
DATA_DIR=./data

# Model runtime: ollama | openai | fake (offline demo, no GPU)
RUNTIME_KIND=ollama
RUNTIME_URL=https://your-workspace--localschool-ollama-serve.modal.run
RUNTIME_TOKEN=
# Modal proxy auth (or any extra headers) as JSON
RUNTIME_HEADERS={"Modal-Key": "wk-...", "Modal-Secret": "ws-..."}
# First request after the GPU sleeps can take ~1–2 minutes on Modal
RUNTIME_TIMEOUT_S=180

# Default models (admins can switch in Admin → Models)
CHAT_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
MAX_CONCURRENT_GENERATIONS=2

# Shown in the app and to the Mac app when it discovers this server
SCHOOL_NAME=Maple Grove Middle School
# Announce this server on the LAN (Bonjour) so the Mac app finds it automatically.
# Needs host networking: run natively, or `network_mode: host` in Docker on Linux.
ADVERTISE_MDNS=true
PUBLIC_PORT=8000

# First admin account (created on first start only)
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=change-me-now

# Set true when serving over HTTPS
COOKIE_SECURE=false
