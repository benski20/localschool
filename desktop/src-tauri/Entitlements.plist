<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Meeting recording: with the hardened runtime, macOS refuses the microphone (silently,
       without listing the app in Privacy & Security → Microphone) unless this is signed in. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
