{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local School",
  "version": "0.1.0",
  "identifier": "org.localschool.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Private AI for your school",
    "longDescription": "Ask questions about your school's policies, curriculum and your classes. Answers come from your school's own Local School server and cite their sources. No AI models run on this Mac.",
    "copyright": "Local School",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": { "width": 600, "height": 400 },
        "appPosition": { "x": 160, "y": 190 },
        "applicationFolderPosition": { "x": 440, "y": 190 }
      }
    }
  }
}
